# Qloo hackathon key. Only works against https://hackathon.api.qloo.com
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# 1 = serve documented-shape fixtures instead of calling Qloo (development only)
QLOO_MOCK=1

# Gemini (free tier) drives the agent loop
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest

# AGENT_MODE=scripted runs a fixed offline agent; only allowed with QLOO_MOCK=1
AGENT_MODE=
